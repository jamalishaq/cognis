# Environment
ENVIRONMENT=local

# AWS Region
AWS_REGION=us-east-1

# AWS credentials — required locally for Bedrock (not used for DynamoDB/SQS which are mocked)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Local service endpoints
DYNAMODB_ENDPOINT=http://dynamodb-local:8001
SQS_ENDPOINT=http://elasticmq:9324

# Feature flags for local dev
S3_VECTORS_MOCK=true
SES_MODE=log
AUTH_DISABLED=true

# SQS queue URLs (ElasticMQ)
NOTIFICATION_QUEUE_URL=http://elasticmq:9324/000000000000/notification-queue
INGESTION_QUEUE_URL=http://elasticmq:9324/000000000000/ingestion-queue
